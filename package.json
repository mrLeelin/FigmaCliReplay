{
  "name": "figma-relay",
  "version": "0.1.50",
  "private": true,
  "type": "module",
  "bin": {
    "figma-relay": "dist/cli.js"
  },
  "scripts": {
    "cli": "node dist/cli.js",
    "ai:install-skill": "node scripts/install_ai_skill.mjs",
    "build": "npm run build:ui && tsc -p tsconfig.json",
    "build:ui": "python scripts/build.py",
    "dev": "tsx src/index.ts",
    "doctor": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/doctor_relay.ps1",
    "smoke": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/smoke_relay.ps1",
    "oneclick": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start_relay.ps1",
    "package:release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package_release.ps1",
    "publish:github": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/publish_github_release.ps1",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "pino": "^9.7.0",
    "ws": "^8.18.2",
    "zod": "^3.25.28"
  },
  "devDependencies": {
    "@types/node": "^22.15.24",
    "@types/ws": "^8.18.1",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
